# Sao chép thành gateway.env. Gateway chạy cùng máy với MT5 và chỉ nghe 127.0.0.1.
OCEAN_SERVER_URL=http://127.0.0.1:8090
# Trùng OCEAN_EA_KEY của Server (>= 24 ký tự)
OCEAN_EA_KEY=
OCEAN_GW_PORT=47800
# Khung giờ được phép (để trống = tất cả)
OCEAN_TFS=M3,M5,M15,H1
# Tên symbol ở sàn của bạn, ví dụ TradingView XAUUSD -> sàn GOLD
OCEAN_SYMBOL_MAP=XAUUSD=GOLD
