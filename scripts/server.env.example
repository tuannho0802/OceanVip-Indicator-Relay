# Sao chép thành server.env và đổi hết giá trị. Mỗi bí mật nên >= 24 ký tự ngẫu nhiên.
OCEAN_PORT=8090
OCEAN_HOST=127.0.0.1
OCEAN_DB=C:\ProgramData\OceanRelay\ocean.db
# Đặt vào URL webhook của TradingView:  https://<tunnel-hoặc-domain>/webhook?key=<giá trị này>
OCEAN_WEBHOOK_KEY=
# Bí mật giữa Gateway và Server
OCEAN_GATEWAY_TOKEN=
# Token đăng nhập giao diện web
OCEAN_ADMIN_TOKEN=
# Tín hiệu cũ hơn số giây này sẽ không giao cho EA
OCEAN_MAX_AGE_SEC=120
OCEAN_DEDUPE_SEC=300
