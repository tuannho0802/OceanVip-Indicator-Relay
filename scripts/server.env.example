# Sao chép thành server.env (hoặc dùng scripts\init-env.ps1 để tự sinh khóa). Mỗi khóa chỉ gồm chữ, số, _ và -.
OCEAN_PORT=8090
OCEAN_HOST=127.0.0.1
OCEAN_SRV_NAME=OCEAN Relay
# Thư mục dữ liệu (DB, log, cloudflared). Mặc định Windows: C:\ProgramData\OceanRelay
# OCEAN_DATA=C:\ProgramData\OceanRelay

# BẮT BUỘC (>= 24 ký tự): khóa giữa Gateway/EA và Server. Gateway dùng khóa này để kiểm chữ ký từng tín hiệu.
OCEAN_EA_KEY=

# Dùng Worker Cloudflare (khuyến nghị): Server kéo bù và nhận push của Worker. Cả hai phải đi cùng nhau.
OCEAN_WORKER_URL=
# >= 32 ký tự, TRÙNG SYNC_KEY của Worker
OCEAN_SYNC_KEY=
# Quick Tunnel (không cần tên miền): Server tự chạy cloudflared và báo địa chỉ mới lên Worker mỗi lần đổi
OCEAN_QUICK_TUNNEL=1
# Hoặc Cloudflare Tunnel có tên + domain: địa chỉ HTTPS công khai của VPS (thay cho Quick Tunnel)
# OCEAN_PUBLIC_URL=https://relay.example.com

# Webhook gọi thẳng vào Server (khi KHÔNG dùng Worker). Để trống = tắt.
# OCEAN_WEBHOOK_KEY=

# Tín hiệu cũ hơn số giây này không giao cho EA; cửa sổ chống trùng
OCEAN_MAX_AGE_SEC=120
OCEAN_DEDUPE_SEC=300
# OCEAN_POLL_SEC=30
# OCEAN_LOG_LEVEL=info
